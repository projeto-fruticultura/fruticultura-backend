{
  "name": "fruticultura-backend",
  "version": "1.0.0",
  "description": "Backend principal da plataforma de monitoramento climático e logístico da fruticultura do Vale do São Francisco.",
  "main": "src/server.js",
  "scripts": {
"dev": "nodemon src/server.js",
  "start": "node src/server.js",
  "postinstall": "prisma generate",

  "db:testar": "prisma db pull --print",
  "db:migrar": "prisma migrate dev",
  "db:seed": "node prisma/seed.js",

  "test": "jest --runInBand",
  "test:unit": "jest --runInBand tests/regras.test.js tests/janelas.test.js",
  "test:api": "jest --runInBand tests/api.test.js",
  "check": "prisma validate",
  "build": "prisma generate"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "6.19.3",
    "axios": "^1.20.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prisma": "6.19.3",
    "supertest": "^7.3.2"
  },
  "prisma": {
    "seed": "node prisma/seed.js"
  }
}
