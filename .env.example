# Modelo do arquivo .env. Copie para .env (no cmd: copy .env.example .env) e troque os valores.
# O .env NUNCA vai para o Git. Aqui so ha nomes e exemplos falsos: nunca coloque valor real neste arquivo.

# ---------- Banco de dados ----------
# Endereco de conexao com o PostgreSQL (obrigatoria). Use a URL do SEU banco; nao rode migration
# nem seed no banco compartilhado do grupo.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST/NOME_DO_BANCO?sslmode=require"

# ---------- Servidor e CORS ----------
# Porta em que o servidor sobe (opcional; se faltar, usa 3000).
PORT=3000
# Endereco do front que pode chamar a API pelo navegador (opcional; se faltar, nenhum site externo e liberado).
CORS_ORIGIN="http://localhost:5173"

# ---------- Autenticacao ----------
# Chave que assina os tokens de login (obrigatoria, com 32 ou mais caracteres; sem ela o servidor nao sobe).
# Gere a sua com o comando abaixo, cole aqui e nunca compartilhe:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Este exemplo e curto de proposito: o servidor se recusa a subir ate voce trocar.
JWT_SECRET="troque-por-um-valor-forte"
# Validade do login, com unidade: 30m, 2h, 1d (opcional; se faltar, usa 2h).
JWT_EXPIRES_IN="2h"

# ---------- Seed (so para npm run db:seed) ----------
# Administrador criado pelo seed. Obrigatorias so se for rodar o seed, e so em banco proprio e vazio.
SEED_ADMIN_EMAIL="admin@valesafra.local"
SEED_ADMIN_SENHA="troque-esta-senha"

# ---------- ThingSpeak e leituras ----------
# Canal do ThingSpeak de onde vem a temperatura e a umidade (todas obrigatorias para buscar leituras).
THINGSPEAK_CHANNEL_ID="1234567"
THINGSPEAK_READ_KEY="troque-pela-chave-de-leitura"
# Codigo do sensor, cadastrado no banco, que recebe essas leituras.
THINGSPEAK_SENSOR_CODIGO="ESP32-EXEMPLO-01"
# O agendador de leituras vem DESLIGADO por padrao. So liga com exatamente "true".
# Em banco compartilhado, so UMA pessoa deve ligar: se varias ligarem, cada maquina busca e grava ao mesmo tempo.
LEITURAS_AGENDADOR_ATIVO="false"
# De quanto em quanto tempo o agendador busca, em minutos (opcional; se faltar, usa 5; aceita de 1 a 1440).
LEITURAS_INTERVALO_MIN="5"

# ---------- Precos de mercado (CONAB) ----------
# Desligado por padrao. Com exatamente "true", o servidor baixa o arquivo da CONAB (cerca de 180 MB) ao subir,
# em segundo plano, e o primeiro pedido a /api/precos ja sai rapido. Ligue para a demonstracao.
CONAB_AQUECER_AO_INICIAR="false"
