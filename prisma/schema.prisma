generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Perfil {
  PRODUTOR
  TECNICO
  ADMIN
}

enum Status {
  ATIVO
  INATIVO
}

enum FaseFenologica {
  VEGETATIVA
  FLORACAO_PANICULA
  FRUTIFICACAO
  MATURACAO
}

model Usuario {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(150)
  email        String   @unique @db.VarChar(254)
  senha        String   @db.VarChar(255)
  perfil       Perfil
  status       Status   @default(ATIVO)
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  propriedades Propriedade[]
  vinculos     TecnicoPropriedade[]
}

model Propriedade {
  id           Int      @id @default(autoincrement())
  nome         String   @db.VarChar(255)
  area         Decimal  @db.Decimal(10, 2)
  uf           String   @db.Char(2)
  cidade       String   @db.VarChar(100)
  latitude     Decimal  @db.Decimal(10, 8)
  longitude    Decimal  @db.Decimal(11, 8)
  status       Status   @default(ATIVO)
  usuarioId    Int
  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  usuario        Usuario              @relation(fields: [usuarioId], references: [id])
  lotes          Lote[]
  rotasLogistica RotaLogistica[]
  tecnicos       TecnicoPropriedade[]

  @@index([usuarioId])
}

model Cultura {
  id             Int     @id @default(autoincrement())
  nome           String  @db.VarChar(100)
  variedade      String? @db.VarChar(100)
  descricao      String? @db.Text
  temperaturaMin Decimal @db.Decimal(5, 2)
  temperaturaMax Decimal @db.Decimal(5, 2)
  umidadeMin     Decimal @db.Decimal(5, 2)
  umidadeMax     Decimal @db.Decimal(5, 2)

  lotes Lote[]
}

model Lote {
  id               Int             @id @default(autoincrement())
  identificacao    String          @db.VarChar(100)
  area             Decimal         @db.Decimal(10, 2)
  dataPlantacao    DateTime        @db.Date
  colheitaEstimada DateTime?       @db.Date
  situacao         String          @db.VarChar(30)
  propriedadeId    Int
  culturaId        Int
  status           Status          @default(ATIVO)
  latitude         Decimal?        @db.Decimal(10, 8)
  longitude        Decimal?        @db.Decimal(11, 8)
  faseFenologica   FaseFenologica?

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id])
  cultura     Cultura     @relation(fields: [culturaId], references: [id])
  sensores    Sensor[]

  @@index([propriedadeId])
}

model Sensor {
  id             Int      @id @default(autoincrement())
  codigo         String   @unique @db.VarChar(45)
  tipo           String   @db.VarChar(45)
  localizacao    String?  @db.VarChar(150)
  dataInstalacao DateTime @db.Date
  status         Status   @default(ATIVO)
  channelId      String?  @db.VarChar(20)
  readApiKey     String?  @db.VarChar(64)
  loteId         Int

  lote         Lote          @relation(fields: [loteId], references: [id])
  leituras     Leitura[]
  alertasRisco AlertaRisco[]

  @@index([loteId])
}

model Leitura {
  id              Int      @id @default(autoincrement())
  sensorId        Int
  temperatura     Float
  umidade         Float
  dataHoraLeitura DateTime
  criadoEm        DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Restrict)

  @@unique([sensorId, dataHoraLeitura])
}

model RotaLogistica {
  id                 Int      @id @default(autoincrement())
  propriedadeId      Int
  origem             String   @db.VarChar(150)
  destino            String   @db.VarChar(150)
  modal              String   @db.VarChar(20)
  tempoEstimadoHoras Decimal  @db.Decimal(6, 1)
  custo              Decimal  @db.Decimal(12, 2)
  transportadora     String   @db.VarChar(150)
  situacao           String   @db.VarChar(20)
  status             Status   @default(ATIVO)
  criadoEm           DateTime @default(now())
  atualizadoEm       DateTime @updatedAt

  propriedade Propriedade @relation(fields: [propriedadeId], references: [id])

  @@index([propriedadeId])
}

model TecnicoPropriedade {
  usuarioId     Int
  propriedadeId Int
  criadoEm      DateTime @default(now())

  usuario     Usuario     @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  propriedade Propriedade @relation(fields: [propriedadeId], references: [id], onDelete: Restrict)

  @@id([usuarioId, propriedadeId])
  @@index([propriedadeId])
}

model AlertaRisco {
  id             Int      @id @default(autoincrement())
  sensorId       Int
  tipo           String   @db.VarChar(40)
  nivel          String   @db.VarChar(10)
  inicio         DateTime
  fim            DateTime
  duracaoMinutos Float
  regraVersao    String   @default("heuristica-v1") @db.VarChar(40)
  criadoEm       DateTime @default(now())

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Restrict)

  @@unique([sensorId, tipo, inicio, nivel])
  @@index([sensorId, fim])
}

model Auditoria {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  operacao  String   @db.VarChar(10)
  recurso   String   @db.VarChar(60)
  recursoId String?  @db.VarChar(60)
  dataHora  DateTime @default(now())
  ip        String   @db.VarChar(64)

  @@index([usuarioId, dataHora])
}
